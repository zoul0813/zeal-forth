{
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${env:ZVB_SDK_PATH}/include",
    "${env:ZVB_SDK_PATH}/sdcc",
    "${env:ZOS_PATH}/kernel_headers/sdcc/include",
    "${env:ZGDK_PATH}/include",
    "${env:COREUTILS_PATH}/libsrc/*/"
  ],
  "C_Cpp.default.forcedInclude": ["${ZDE_PATH}/includes/vscode.h"],
  "C_Cpp.clang_format_sortIncludes": false,
  "C_Cpp.clang_format_style": "file:${ZDE_PATH}/.clang-format",
  "z80-macroasm.seekSymbolsThroughWorkspace": true,
  "z80-macroasm.format.enabled": false,
  "z80-macroasm.format.baseIndent": 2,
  "z80-macroasm.format.controlIndent": 1,
  "z80-macroasm.format.whitespaceAfterInstruction": "single-space",
  "z80-macroasm.format.spaceAfterArgument": true,
  "z80-macroasm.format.spaceAfterInstruction": true,
  "z80-macroasm.format.spacesAroundOperators": true,
  "z80-macroasm.format.uppercaseKeywords": "auto",
  "z80-macroasm.format.bracketType": "no-change",
  "z80-macroasm.format.colonAfterLabels": true,
  "z80-macroasm.format.hexaNumberStyle": "c-style",
  "z80-macroasm.format.hexaNumberCase": true,
  "z80-macroasm.format.splitInstructionsByColon": true,
  "z80-macroasm.suggestOnInstructions": false,
  "z80-macroasm.files.include": "**/*.asm",
  "workbench.editorAssociations": {
    "*.ztp": "hexEditor.hexedit",
    "*.zts": "hexEditor.hexedit",
    "*.ztm": "hexEditor.hexedit",
    "*.bin": "hexEditor.hexedit"
  },
  "prettier.tabWidth": 2,
  "prettier.useTabs": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "files.associations": {
    "*.asm": "z80-macroasm",
    "*.fs": "forth"
  }
}
